# Maintainer: n0 team <hello@n0.computer>
# Generated by packaging/gateway/aur/pkgbuild.py in
# https://github.com/n0-computer/iroh-content-discovery; edit it there.
pkgname=iroh-link-gateway-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Local HTTP gateway for blake3.net and pkarr.net links, served from iroh peers'
arch=('x86_64' 'aarch64')
url='https://github.com/n0-computer/iroh-content-discovery'
license=('MIT OR Apache-2.0')
provides=('iroh-link-gateway')
conflicts=('iroh-link-gateway')
options=('!debug')
source_x86_64=("$url/releases/download/gateway-v$pkgver/iroh-link-gateway-$pkgver-linux-x64.tar.gz")
source_aarch64=("$url/releases/download/gateway-v$pkgver/iroh-link-gateway-$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
  cd iroh-link-gateway-$pkgver-linux-*/
  install -Dm755 iroh-link-gateway -t "$pkgdir/usr/bin"
  install -Dm644 systemd/system/iroh-link-gateway.service -t "$pkgdir/usr/lib/systemd/system"
  install -Dm644 systemd/user/iroh-link-gateway.service -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE-APACHE LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname"
  install -dm755 "$pkgdir/usr/share/iroh-link-gateway"
  cp -r --no-preserve=ownership extensions "$pkgdir/usr/share/iroh-link-gateway/"
}
