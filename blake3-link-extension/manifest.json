{
  "manifest_version": 3,
  "name": "blake3.link Local Gateway",
  "version": "0.1.0",
  "description": "Open blake3.link content through your local iroh HTTP gateway.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "http://*.blake3.link/*",
    "https://*.blake3.link/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Local gateway",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "blake3-link-gateway@iroh.computer",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
