{
  "manifest_version": 3,
  "name": "iroh link",
  "version": "0.2.1",
  "description": "Open blake3.net content and resolve pkarr.net names through your local iroh HTTP gateway.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "http://*.blake3.net/*",
    "https://*.blake3.net/*",
    "http://*.pkarr.net/*",
    "https://*.pkarr.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "iroh link",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "blake3-link-gateway@iroh.computer",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
